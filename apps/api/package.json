{
  "name": "api",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "nest build client && nest build processor",
    "start": "nest start",
    "start:client": "nest start client",
    "start:processor": "nest start processor",
    "dev:api:client:local": "set -a && source .env.local && set +a && nest start client --watch",
    "dev:api:processor:local": "set -a && source .env.local && set +a && nest start processor --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate:local": "set -a && source .env.local && set +a && prisma migrate dev",
    "prisma:seed:local": "set -a && source .env.local && set +a && tsx prisma/seed.ts",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/swagger": "^11.2.3",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "bullmq": "^5.63.0",
    "decimal.js": "^10.5.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shared": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.8.1",
    "@types/pg": "^8.15.5",
    "eslint": "^9.38.0",
    "jest": "^30.2.0",
    "prisma": "7.7.0",
    "ts-loader": "^9.5.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  }
}
